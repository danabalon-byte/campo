rules_version = '2';
// Reglas de seguridad de Control del Campo.
// Dueño: anabalondiego@gmail.com. Los demás se autorizan en el documento config/roles (campos "admins" y "members", con correos en minúsculas).
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null && request.auth.token.email_verified == true; }
    function mail() { return request.auth.token.email.lower(); }
    function rolesDoc() { return get(/databases/$(database)/documents/config/roles).data; }
    function hasRoles() { return exists(/databases/$(database)/documents/config/roles); }
    function isOwner() { return signed() && mail() == 'anabalondiego@gmail.com'; }
    function isAdmin() { return isOwner() || (signed() && hasRoles() && mail() in rolesDoc().get('admins', [])); }
    function isMember() { return isAdmin() || (signed() && hasRoles() && mail() in rolesDoc().get('members', [])); }

    match /config/{doc} {
      allow read: if isMember();
      allow write: if isOwner();
    }
    // Asistencia: cada persona escribe la suya; el administrador y el dueño ven y corrigen todas.
    match /asistencia/{uid}/{rest=**} {
      allow read, write: if isAdmin() || (isMember() && request.auth.uid == uid);
    }
    match /equipo/{uid} {
      allow read: if isMember();
      allow write: if isOwner() || (isMember() && request.auth.uid == uid);
    }
    match /cuarteles/{d} { allow read: if isMember(); allow write: if isOwner(); }
    match /productos/{d} { allow read: if isMember(); allow write: if isOwner(); }
    match /movimientos/{d} { allow read: if isMember(); allow write: if isOwner(); }
    match /permisos_res/{d} { allow read: if isMember(); allow write: if isOwner(); }
    match /saldos/{d} { allow read: if isMember(); allow write: if isOwner(); }
    match /personal/{d=**} { allow read, write: if isAdmin(); }
    match /jornadas/{d=**} { allow read, write: if isAdmin(); }
    match /solicitudes/{d} { allow read, write: if isAdmin(); }
    // Terceros y jornadas: el dueño ve todo; la encargada ve y registra solo lo que ella misma anotó (consultas con where uid == su cuenta).
    function esMio() { return request.auth.uid == resource.data.uid; }
    match /terceros/{d} {
      allow read: if isOwner() || (isAdmin() && esMio());
      allow create: if isOwner() || (isAdmin() && request.resource.data.uid == request.auth.uid);
      allow update: if isOwner() || (isAdmin() && esMio() && request.resource.data.uid == request.auth.uid);
      allow delete: if isOwner();
    }
    match /jornadasTerc/{d} {
      allow read: if isOwner() || (isAdmin() && esMio());
      // Una encargada no puede autorizar feriados: solo puede crear con aut "pendiente" (o sin aut) y no puede cambiarlo.
      allow create: if isOwner() || (isAdmin() && request.resource.data.uid == request.auth.uid
        && (!('aut' in request.resource.data) || request.resource.data.aut == 'pendiente'));
      allow update: if isOwner() || (isAdmin() && esMio() && request.resource.data.uid == request.auth.uid
        && request.resource.data.get('aut', null) == resource.data.get('aut', null));
      allow delete: if isOwner() || (isAdmin() && esMio());
    }
    // Valores, pagos y sábados acordados: solo el dueño.
    match /tarifas/{d} { allow read, write: if isOwner(); }
    match /abonos/{d} { allow read, write: if isOwner(); }
    match /semanasT/{d} { allow read, write: if isOwner(); }
    match /arboles/{d} { allow read, write: if isMember(); }
    // Fotos de árboles: cualquiera del equipo puede subir y ver; solo el dueño puede borrar. Máximo ~400 KB por foto.
    match /fotos/{d} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.data.size() < 400000;
      allow update, delete: if isOwner();
    }
    // Agenda: las tareas las agenda y quita la administración; cualquiera del equipo las marca como hechas.
    match /tareas/{d} {
      allow read: if isMember();
      allow create, delete: if isAdmin();
      allow update: if isMember();
    }
    // Libreta de ideas y recordatorios del equipo.
    match /ideas/{d} { allow read, write: if isMember(); }
    match /trabajos/{d} { allow read, write: if isMember(); }
    match /aplicaciones/{d} { allow read, write: if isMember(); }
    match /riegos/{d} { allow read, write: if isMember(); }
    match /plan/{d} { allow read, write: if isMember(); }
    match /consultas/{d} { allow read, write: if isMember(); }
    match /permisos/{d} { allow read, write: if isMember(); }
  }
}
